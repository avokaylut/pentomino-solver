           RowBox[{"{", 
            RowBox[{"2", ",", "3"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"3", ",", "3"}], "}"}]}], "}"}]}], "}"}]}], 
      "\[IndentingNewLine]", "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"chooseBoardSize", "[", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"boardSize", ",", 
         RowBox[{"validSizes", "=", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"4", ",", "15"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"6", ",", "10"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"3", ",", "20"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"5", ",", "12"}], "}"}]}], "}"}]}]}], "}"}], ",", 
       RowBox[{
        RowBox[{"boardSize", "=", 
         RowBox[{
         "Input", "[", 
          "\"\<Enter board size (1 for 4x15, 2 for 6x10, 3 for 3x20, 4 for \
5x12)\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Switch", "[", 
         RowBox[{"boardSize", ",", "1", ",", 
          RowBox[{"{", 
           RowBox[{"4", ",", "15"}], "}"}], ",", "2", ",", 
          RowBox[{"{", 
           RowBox[{"6", ",", "10"}], "}"}], ",", "3", ",", 
          RowBox[{"{", 
           RowBox[{"3", ",", "20"}], "}"}], ",", "4", ",", 
          RowBox[{"{", 
           RowBox[{"5", ",", "12"}], "}"}], ",", "_", ",", 
          RowBox[{
          "Print", "[", "\"\<Invalid choice. Please enter 1, 2, 3, or 4.\>\"", 
           "]"}]}], "]"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"height", ",", "width"}], "}"}], " ", "=", " ", 
     RowBox[{"chooseBoardSize", "[", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pole", " ", "=", " ", 
