Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"height", ",", "width"}], "}"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pole", "//", "MatrixForm"}], " ", ";"}], "\[IndentingNewLine]", 
   RowBox[{"freeFigures", "=", 
    RowBox[{"RandomSample", "[", 
     RowBox[{
      RowBox[{"figures", "\[LeftDoubleBracket]", 
       RowBox[{"All", ",", "1", ",", "1"}], "\[RightDoubleBracket]"}], "//", 
      "DeleteDuplicates"}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"usedFigures", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"unluckyVariations", "=", 
     RowBox[{"{", "}"}]}], ";"}], " ", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"allPositions", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"i", ",", "j"}], "}"}], ",", 
