            RowBox[{"3", ",", 
             RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
