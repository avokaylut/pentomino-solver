        RowBox[{"{", "0", "}"}]}], "}"}], "}"}]}], ";"}]}]}]], "Input"],

Cell[BoxData[
 RowBox[{"ClearAll", "[", 
  RowBox[{
  "freePos", ",", "posQ", ",", "possiblePlace", ",", "place", ",", "remove"}],
   "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"freePos", "[", 
      RowBox[{"pole_", ",", "allPos_"}], "]"}], ":=", 
     RowBox[{"SelectFirst", "[", 
      RowBox[{"allPos", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"pole", "\[LeftDoubleBracket]", 
          RowBox[{"Sequence", "@@", "#"}], "\[RightDoubleBracket]"}], 
         "\[Equal]", "0"}], "&"}]}], "]"}]}], ";"}], " ", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"posQ", "[", "position_", "]"}], ":=", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "<=", 
         RowBox[{
         "position", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
         "\[LessEqual]", "height"}], ")"}], "&&", " ", 
       RowBox[{"(", 
        RowBox[{"1", "\[LessEqual]", 
         RowBox[{
         "position", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
         "\[LessEqual]", " ", "width"}], ")"}]}], ")"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"possiblePlace", "[", 
      RowBox[{"pole_", ",", "figure_"}], "]"}], ":=", 
     RowBox[{"AllTrue", "[", 
      RowBox[{"figure", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"posQ", "[", "#", "]"}], " ", "&&", " ", 
         RowBox[{
          RowBox[{"pole", "[", 
           RowBox[{"[", 
            RowBox[{"Sequence", "@@", "#"}], "]"}], "]"}], "==", "0"}]}], 
        "&"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"place", "[", 
      RowBox[{"color_", ",", "figure_"}], "]"}], ":=", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"pole", "\[LeftDoubleBracket]", 
           RowBox[{"Sequence", "@@", 
            RowBox[{"(", 
             RowBox[{"#", "+", "shift"}], ")"}]}], "\[RightDoubleBracket]"}], 
          "=", "color"}], ")"}], "&"}], "/@", "figure"}], " ", ")"}]}], ";"}],
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"remove", "[", "color_", "]"}], ":=", 
     RowBox[{"(", 
      RowBox[{"pole", "=", 
       RowBox[{"pole", "//.", 
        RowBox[{"color", "\[Rule]", "0"}]}]}], ")"}]}], " ", ";"}], 
   "\[IndentingNewLine]"}]}]], "Input"],

Cell[BoxData[
 RowBox[{"ClearAll", "[", 
  RowBox[{"placeVoidQ", ",", "voidQ", ",", "allVoids"}], "]"}]], "Input"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"placeVoidQ", "[", "figure_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"poleCopy", "=", "pole"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"poleCopy", "\[LeftDoubleBracket]", 
           RowBox[{"Sequence", "@@", 
            RowBox[{"(", 
             RowBox[{"#", "+", "shift"}], ")"}]}], "\[RightDoubleBracket]"}], 
          "=", "1"}], ")"}], "&"}], "/@", "figure"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"voidQ", "[", 
       RowBox[{"poleCopy", ",", "allPositions"}], "]"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"voidQ", " ", "[", 
    RowBox[{"pole_", ",", "positions_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "seeGroupVoids", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"seeGroupVoids", " ", "=", " ", 
       RowBox[{"allVoids", "[", 
        RowBox[{"pole", ",", "positions"}], "]"}]}], ";", " ", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "@", 
          RowBox[{"Select", "[", 
           RowBox[{"seeGroupVoids", ",", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"Mod", "[", 
               RowBox[{
                RowBox[{"Length", "@", "#"}], " ", ",", "5"}], "]"}], "!=", 
              "0"}], "&"}]}], "]"}]}], "==", "0"}], ",", "True", ",", 
        "False"}], "]"}]}]}], " ", "\[IndentingNewLine]", "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     
      RowBox[{
       "all", "Voids"}], "[", 
     RowBox[{"pole_", ",", " ", "positions_"}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{"voids", ",", " ", "\[IndentingNewLine]", 
        RowBox[{"meetings", "=", 
         RowBox[{"<|", "|>"}]}], ",", " ", "\[IndentingNewLine]", "openVoids",
         ",", " ", "\[IndentingNewLine]", "current", ",", " ", 
        "\[IndentingNewLine]", "tempCurrent", ",", "   ", 
        "\[IndentingNewLine]", "currentNeighbours", ",", "  ", 
        "\[IndentingNewLine]", "neighbour", ",", "  ", "\[IndentingNewLine]", 
        RowBox[{"currentVoid", "=", 
         RowBox[{"{", "}"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{"groupVoids", "=", 
         RowBox[{"{", "}"}]}], ",", " ", "\[IndentingNewLine]", 
        RowBox[{"translations", " ", "=", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", "0"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "1"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "1"}], ",", "0"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", 
             RowBox[{"-", "1"}]}], "}"}]}], "}"}]}]}], "   ", 
       "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"voids", " ", "=", " ", 
        RowBox[{"Select", "[", 
         RowBox[{"positions", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"pole", "\[LeftDoubleBracket]", 
             RowBox[{"Sequence", "@@", "#"}], "\[RightDoubleBracket]"}], 
            "\[Equal]", "0"}], "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"meetings", "[", "i", "]"}], "=", "0"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", "voids"}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"While", "[", 
        RowBox[{
         RowBox[{"voids", " ", "\[NotEqual]", " ", 
          RowBox[{"{", "}"}]}], ",", "\[IndentingNewLine]", "\t", 
         RowBox[{
          RowBox[{"openVoids", " ", "=", " ", 
           RowBox[{"Select", "[", 
            RowBox[{"voids", ",", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"meetings", "[", "#", "]"}], "=!=", "1"}], "&"}]}], 
            "]"}]}], ";", "\[IndentingNewLine]", "\t", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"openVoids", " ", "\[Equal]", " ", 
             RowBox[{"{", "}"}]}], ",", "\[IndentingNewLine]", "\t\t", 
            RowBox[{"Break", "[", "]"}], ",", "\[IndentingNewLine]", "\t", 
            RowBox[{"(*", "Else", "*)"}], "\[IndentingNewLine]", "\t\t", 
            RowBox[{
             RowBox[{"current", " ", "=", " ", 
              RowBox[{
              "openVoids", "\[LeftDoubleBracket]", "1", 
               "\[RightDoubleBracket]"}]}], ";", "  ", "\[IndentingNewLine]", 
             "\t\t", 
             RowBox[{
              RowBox[{"meetings", "[", "current", "]"}], "=", "1"}], ";"}]}], 
           "\[IndentingNewLine]", "\t", "]"}], ";", "\[IndentingNewLine]", 
          "\t", 
          RowBox[{"currentNeighbours", " ", "=", " ", 
           RowBox[{"{", "current", "}"}]}], ";", " ", "\[IndentingNewLine]", 
          "\t", 
          RowBox[{"currentVoid", "=", 
           RowBox[{"{", "current", "}"}]}], ";", "\[IndentingNewLine]", "\t", 
          RowBox[{"While", "[", 
           RowBox[{
            RowBox[{"currentNeighbours", " ", "\[NotEqual]", " ", 
             RowBox[{"{", "}"}]}], ",", "\[IndentingNewLine]", "\t\t", 
            RowBox[{
             RowBox[{"tempCurrent", " ", "=", " ", 
              RowBox[{
              "currentNeighbours", "\[LeftDoubleBracket]", "1", 
               "\[RightDoubleBracket]"}]}], ";", "\[IndentingNewLine]", 
             "\t\t", 
             RowBox[{"currentNeighbours", "=", 
              RowBox[{"Rest", "@", "currentNeighbours"}]}], ";", 
             "\[IndentingNewLine]", "\t\t", 
             RowBox[{"Do", "[", "\[IndentingNewLine]", "\t\t\t", 
              RowBox[{
               RowBox[{
                RowBox[{"neighbour", " ", "=", " ", 
                 RowBox[{"tempCurrent", "+", "i"}]}], ";", 
                "\[IndentingNewLine]", "\t\t\t", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"posQ", "[", "neighbour", "]"}], " ", "&&", " ", 
                   RowBox[{
                    RowBox[{"meetings", "[", "neighbour", "]"}], "=!=", " ", 
                    "1"}], " ", "&&", " ", 
                   RowBox[{
                    RowBox[{"pole", "\[LeftDoubleBracket]", 
                    RowBox[{"Sequence", "@@", "neighbour"}], 
                    "\[RightDoubleBracket]"}], "\[Equal]", "0"}]}], ",", 
                  "\[IndentingNewLine]", "\t\t\t\t", 
                  RowBox[{
                   RowBox[{"AppendTo", "[", 
                    RowBox[{"currentNeighbours", ",", "neighbour"}], "]"}], 
                   ";", "\[IndentingNewLine]", "\t\t\t\t", 
                   RowBox[{
                    RowBox[{"meetings", "[", "neighbour", "]"}], "=", "1"}], 
                   ";", "\[IndentingNewLine]", "\t\t\t\t", 
                   RowBox[{"AppendTo", "[", 
                    RowBox[{"currentVoid", ",", "neighbour"}], "]"}], ";"}]}],
                  "\[IndentingNewLine]", "\t\t\t", "]"}], ";"}], 
               "\[IndentingNewLine]", "\t\t", ",", 
               RowBox[{"{", 
                RowBox[{"i", ",", "translations"}], "}"}]}], "]"}]}]}], 
           "\[IndentingNewLine]", "\t\t", "]"}], ";", "\[IndentingNewLine]", 
          "\t", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"groupVoids", ",", 
            RowBox[{"currentVoid", "//", "DeleteDuplicates"}]}], "]"}], 
          ";"}]}], " ", "\[IndentingNewLine]", " ", "]"}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", "groupVoids"}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]"}], "Input"],

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"While", "[", 
     RowBox[{
      RowBox[{"MemberQ", "[", 
       RowBox[{"pole", ",", "0", ",", 
        RowBox[{"{", "2", "}"}]}], "]"}], ",", " ", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"shift", "=", 
        RowBox[{
         RowBox[{"freePos", "[", 
          RowBox[{"pole", ",", "allPositions"}], "]"}], "-", 
         RowBox[{"{", 
          RowBox[{"1", ",", "1"}], "}"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"predPossibleFigs", "=", 
        RowBox[{"Select", "[", 
         RowBox[{"figures", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"FreeQ", "[", 
             RowBox[{
              RowBox[{"usedFigures", "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", "1"}], "]"}], "]"}], ",", 
              RowBox[{"#", "[", 
               RowBox[{"[", 
                RowBox[{"1", ",", "1"}], "]"}], "]"}]}], "]"}], "&&", 
            RowBox[{"FreeQ", "[", 
             RowBox[{"unluckyVariations", ",", 
              RowBox[{"usedFigures", "~", "Join", "~", 
               RowBox[{"{", 
                RowBox[{"#", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], "}"}]}]}], "]"}], "&&", 
            RowBox[{"possiblePlace", "[", 
             RowBox[{"pole", ",", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"#", "+", "shift"}], ")"}], "&"}], "/@", 
               RowBox[{"#", "[", 
                RowBox[{"[", "2", "]"}], "]"}]}]}], "]"}]}], "&"}]}], "]"}]}],
        ";", "\[IndentingNewLine]", 
       RowBox[{"possibleFigs", "=", 
        RowBox[{"Select", "[", 
         RowBox[{"predPossibleFigs", ",", 
          RowBox[{
           RowBox[{"placeVoidQ", "[", 
            RowBox[{"#", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "]"}], "&"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"possibleFigs", "!=", 
          RowBox[{"{", "}"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"color", ",", "toPlace"}], "}"}], "=", 
           RowBox[{"RandomChoice", "@", "possibleFigs"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"usedFigures", ",", "color"}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"freeFigures", "=", 
           RowBox[{"DeleteCases", "[", 
            RowBox[{"freeFigures", ",", 
             RowBox[{"color", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"place", "[", 
           RowBox[{
            RowBox[{"color", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", "toPlace"}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"steps", ",", 
            RowBox[{"{", 
             RowBox[{"pole", ",", 
              RowBox[{"usedFigures", "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", "1"}], "]"}], "]"}]}], "}"}]}], "]"}]}], 
         ",", "\[IndentingNewLine]", 
         RowBox[{"(*", "Else", "*)"}], "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"AppendTo", "[", 
           RowBox[{"unluckyVariations", ",", "usedFigures"}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"freeFigures", ",", 
            RowBox[{"usedFigures", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"-", "1"}], ",", "1"}], "]"}], "]"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"remove", "[", 
           RowBox[{"usedFigures", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"-", "1"}], ",", "1"}], "]"}], "]"}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"usedFigures", "=", 
           RowBox[{"Most", "@", "usedFigures"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"steps", ",", 
            RowBox[{"{", 
             RowBox[{"pole", ",", 
              RowBox[{"usedFigures", "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", "1"}], "]"}], "]"}]}], "}"}]}], "]"}]}]}],
         "]"}]}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"pole", "//", "MatrixForm"}], "\n", 
   RowBox[{"ArrayPlot", "[", 
    RowBox[{"pole", ",", 
     RowBox[{"Mesh", "->", "True"}], ",", 
     RowBox[{"MeshStyle", "->", "White"}]}], "]"}]}]}]], "Input"],

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"stepsAnimate", " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"ArrayPlot", "[", 
       RowBox[{
        RowBox[{"steps", "[", 
         RowBox[{"[", 
          RowBox[{"#", ",", "1"}], "]"}], "]"}], ",", 
        RowBox[{"Mesh", "\[Rule]", "True"}], ",", 
        RowBox[{"MeshStyle", "\[Rule]", "White"}]}], "]"}], "&"}], "/@", 
     RowBox[{"Range", "@", 
      RowBox[{"Length", "@", "steps"}]}]}]}], "\[IndentingNewLine]", 
   RowBox[{"ListAnimate", "[", 
    RowBox[{"stepsAnimate", ",", " ", 
     RowBox[{"AnimationRate", "\[Rule]", "5"}]}], "]"}]}]}]], "Input"]
}, StyleDefinitions->"Default.nb"]
