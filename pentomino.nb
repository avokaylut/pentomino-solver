          RowBox[{"i", ",", "height"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "width"}], "}"}]}], "]"}], ",", "1"}], "]"}]}], 
    ";"}], " ", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"steps", "=", 
     RowBox[{"{", 
